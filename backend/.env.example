# ==============================================================================
# 🚀 TEAMHUB BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Dễ dàng chuyển đổi giữa [MODE 1] LOCAL DEVELOPMENT và [MODE 2] CLOUD PRODUCTION 
# chỉ bằng cách uncomment/comment các nhóm biến bên dưới!
# ==============================================================================

# ------------------------------------------------------------------------------
# 💻 [MODE 1] LOCAL DEVELOPMENT CONFIGURATION (Docker Compose / Local Services)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# 1. Local Postgres (Docker Compose)
DATABASE_URL=postgresql://teamhub:teamhub@localhost:5432/teamhub?schema=public

# 2. Local Redis (BullMQ Queues & Cache)
REDIS_URL=redis://localhost:6379

# 3. Local Object Storage (MinIO / S3)
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=teamhub
STORAGE_SECRET_KEY=teamhub-secret
STORAGE_BUCKET=teamhub
STORAGE_BUCKET_PUBLIC=teamhub-public
STORAGE_REGION=us-east-1

# 4. Local Web & CORS Origins
APP_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,https://admin.socket.io


# ------------------------------------------------------------------------------
# ☁️ [MODE 2] CLOUD PRODUCTION CONFIGURATION (Supabase + Upstash + AWS S3 / Render)
# ------------------------------------------------------------------------------
# NODE_ENV=production
# PORT=4000
#
# # 1. Supabase Postgres Managed Database
# DATABASE_URL=postgresql://postgres:[SUPABASE-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-ID].supabase.co:5432/postgres
#
# # 2. Upstash Redis Serverless (BullMQ Queues & Cache - 1 chuỗi duy nhất chuẩn TLS rediss://)
# REDIS_URL=rediss://default:[UPSTASH-PASSWORD]@[YOUR-UPSTASH-PROJECT-ID].upstash.io:6379
#
# # 3. S3 Storage (Tương thích AWS S3, Cloudflare R2, hoặc Supabase Storage)
# STORAGE_PROVIDER=s3 # Hoặc supabase / cloudflare_r2
# STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com # Hoặc URL Supabase S3
# STORAGE_ACCESS_KEY=[YOUR-AWS-OR-SUPABASE-ACCESS-KEY]
# STORAGE_SECRET_KEY=[YOUR-AWS-OR-SUPABASE-SECRET-KEY]
# STORAGE_BUCKET=teamhub-attachments
# STORAGE_BUCKET_PUBLIC=teamhub-public
# STORAGE_REGION=us-east-1
#
# # 4. Production Web & CORS Origins (Render & Vercel)
# APP_WEB_URL=https://teamhub-frontend.vercel.app
# CORS_ORIGIN=https://teamhub-frontend.vercel.app
#
# ==============================================================================
# 🤖 AI SERVICE & PROVIDER CONFIGURATION
# ==============================================================================
# AI_PROVIDER: 'auto' (tự động thử Gemini -> Groq -> OpenAI -> OpenRouter),
# hoặc chỉ định duy nhất 1 provider: 'gemini', 'groq', 'openai', 'openrouter'
AI_PROVIDER=auto

# (Tùy chọn) Chỉ định Model tên cụ thể:
# AI_MODEL=gemini-1.5-flash

# 1. Google Gemini API Key (Lấy miễn phí tại: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_google_gemini_api_key_here

# 2. Groq AI API Key (Lấy miễn phí tốc độ cao tại: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# 3. OpenAI API Key (Tùy chọn: https://platform.openai.com/api-keys)
# OPENAI_API_KEY=your_openai_api_key_here

# 4. OpenRouter API Key (Tùy chọn: https://openrouter.ai/keys)
# OPENROUTER_API_KEY=your_openrouter_api_key_here


# ==============================================================================
# 🔐 AUTHENTICATION & SECURITY KEYS
# ==============================================================================
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

AUTH_COOKIE_NAME=teamhub_refresh
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax


# ==============================================================================
# ⚡ CACHE & RATE LIMITING CONFIGURATION (Redis Engine)
# ==============================================================================
CACHE_ENABLED=true
CACHE_PREFIX=cache:v1
CACHE_ANALYTICS_TTL_SEC=600
CACHE_MEMBERSHIP_TTL_SEC=60
CACHE_BOARD_VIEW_TTL_SEC=120
CACHE_CARD_DETAIL_TTL_SEC=60

CACHE_LOG_ENABLED=false
CACHE_LOG_SAMPLE_RATE=0
CACHE_LOG_KEYS=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PREFIX=rl:v1
RATE_LIMIT_API_WINDOW_SEC=60
RATE_LIMIT_API_MAX=240

TRUST_PROXY=false
ACTIVITY_RETENTION_DAYS=90
