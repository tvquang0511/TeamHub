# ==============================================================================
# ⚙️ TEAMHUB STANDALONE WORKER ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Dễ dàng chuyển đổi giữa [MODE 1] LOCAL DEVELOPMENT và [MODE 2] CLOUD PRODUCTION 
# chỉ bằng cách uncomment/comment các nhóm biến bên dưới!
# ==============================================================================

# ------------------------------------------------------------------------------
# 💻 [MODE 1] LOCAL DEVELOPMENT CONFIGURATION (Docker Compose / Local Services)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://teamhub:teamhub@localhost:5432/teamhub?schema=public
REDIS_URL=redis://localhost:6379

STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=teamhub
STORAGE_SECRET_KEY=teamhub-secret
STORAGE_BUCKET=teamhub
STORAGE_BUCKET_PUBLIC=teamhub-public
STORAGE_REGION=us-east-1

CACHE_PREFIX=cache:v1

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="TeamHub Dev <your_email@gmail.com>"

APP_TIMEZONE=Asia/Ho_Chi_Minh
BLOB_SWEEP_ORPHAN_GRACE_DAYS=7
BLOB_SWEEP_CHAT_UNLINKED_HOURS=24


# ------------------------------------------------------------------------------
# ☁️ [MODE 2] CLOUD PRODUCTION CONFIGURATION (Supabase + Upstash + S3 + Render)
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://postgres:[SUPABASE-PASSWORD]@db.[YOUR-SUPABASE-PROJECT-ID].supabase.co:5432/postgres
# REDIS_URL=rediss://default:[UPSTASH-PASSWORD]@[YOUR-UPSTASH-PROJECT-ID].upstash.io:6379
#
# STORAGE_PROVIDER=supabase
# STORAGE_ENDPOINT=https://[YOUR-SUPABASE-PROJECT-ID].storage.supabase.co/storage/v1/s3
# STORAGE_ACCESS_KEY=[SUPABASE-S3-ACCESS-KEY]
# STORAGE_SECRET_KEY=[SUPABASE-S3-SECRET-KEY]
# STORAGE_BUCKET=attachments
# STORAGE_BUCKET_PUBLIC=teamhub-public
# STORAGE_REGION=ap-south-1
#
# CACHE_PREFIX=cache:v1
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_production_email@gmail.com
# SMTP_PASS=your_production_app_password
# SMTP_FROM="TeamHub Prod <your_production_email@gmail.com>"
#
# APP_TIMEZONE=Asia/Ho_Chi_Minh
# BLOB_SWEEP_ORPHAN_GRACE_DAYS=7
# BLOB_SWEEP_CHAT_UNLINKED_HOURS=24
